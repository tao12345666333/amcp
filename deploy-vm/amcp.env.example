# AMCP runtime configuration for the VM deployment.
# Copy to deploy_vm/amcp.env, fill in real values, scp to the server.
# On the server it lives at /etc/amcp/amcp.env with mode 0600. NEVER commit it.
#
# Same keys as deploy-k8s/secret.yaml — you can copy values from there.
OPENAI_API_KEY=replace-with-your-api-key
AMCP_CHAT_MODEL=zai-org/GLM-5.2-FP8
AMCP_OPENAI_BASE=https://api.gmi-serving.com/v1

# Optional: Telegram polling bot (no inbound port needed).
# WARNING: only ONE running instance per bot token. If the K8s deployment uses
# the same token, one of them will fail with telegram.error.Conflict.
# AMCP_TELEGRAM_BOT_TOKEN=123456:replace-me
# AMCP_TELEGRAM_ALLOWED_USERS=123456789
# AMCP_TELEGRAM_ADMIN_USERS=123456789

# Optional: bind address/port (defaults shown). Keep 127.0.0.1 unless you put
# an authenticating reverse proxy in front — the API has no built-in auth.
# AMCP_VM_HOST=127.0.0.1
# AMCP_VM_PORT=8080
