[Unit]
Description=AMCP coding-agent runtime (VM deployment with in-place self-restart)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/amcp/amcp.env
Environment=AMCP_WORK_DIR=/opt/amcp/data
Environment=AMCP_REPO_DIR=/opt/amcp/repo
Environment=AMCP_VENV_DIR=/opt/amcp/venv
Environment=AMCP_RUNTIME_DIR=/opt/amcp/run
Environment=XDG_CONFIG_HOME=/opt/amcp/data/.config
# Uncomment to make a fast-crashing child visible to systemd as a service
# failure (see README "Notes / security"):
# Environment=AMCP_VM_MIN_UPTIME=30
ExecStart=/usr/local/bin/amcp-vm-supervisor
# In-place restart without a systemd restart:
#   systemctl kill --signal=SIGUSR1 amcp.service   (or just run amcp-vm-restart)
Restart=always
RestartSec=3
TimeoutStopSec=30
# All AMCP state (repo, venv, work dir, config, runtime control files) lives
# under /opt/amcp on the root ext4 filesystem — nothing is on tmpfs, so a
# reboot loses nothing. The supervisor creates /opt/amcp/data and /opt/amcp/run
# on start, so ReadWritePaths only needs /opt/amcp.
ReadWritePaths=/opt/amcp
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
